pipeline {
    agent {
        node {
            label 'Agent-1'
        }
    }
    environment {
        packageVersion=''
        nexusURL='172.31.36.95:8081'
        repositoryName='catalogue'
    }
    options {
        ansiColor('xterm')
        timeout(time: 30, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    stages {
        stage("Get Current Version"){
            steps {
                script {
                    def packageJSON = readJSON file: '92-roboshop-CI-Appln-Code/catalogue/package.json'
                    packageVersion= packageJSON.version
                    echo "Application version is : $packageVersion"
                }
            } 
        }
        // stage("Install dependencies"){
        //     steps {
        //         sh """
        //             sudo dnf module disable nodejs -y
        //             sudo dnf module enable nodejs:18 -y 
        //             sudo dnf install nodejs -y 
        //             cd 92-roboshop-CI-Appln-Code/catalogue/
        //             echo "for npm to work we need to install nodejs first that y above we did"
        //             npm install 
        //         """
        //     } 
        // }
        stage("Install dependencies") {         //check whether version 18 is there or not if not download if present skip those commands 
            steps {
                sh '''
                    NODE_VERSION=$(node --version 2>/dev/null || echo "not-installed")

                    if [[ "$NODE_VERSION" == "v18."* ]]; then
                        echo "Node.js 18 is already installed: $NODE_VERSION"
                    else
                        echo "Node.js 18 is not installed. Installing now..."

                        sudo dnf module disable nodejs -y
                        sudo dnf module enable nodejs:18 -y
                        sudo dnf install nodejs -y
                        sudo dnf install zip -y

                        echo "Node.js installed successfully"
                        node --version
                    fi

                    cd 92-roboshop-CI-Appln-Code/catalogue/

                    echo "Installing npm dependencies..."
                    npm install
                '''
            }
        }
        stage("Build") {
                steps {
                    sh """
                        cd 92-roboshop-CI-Appln-Code/catalogue/
                        ls -la
                        zip -q -r catalogue.zip ./* -x ".git" -x "*.zip"
                        ls -ltr 
                    """
                }
        }
        stage("Publish Artifact") {
            steps {
                sh """
                    cd 92-roboshop-CI-Appln-Code/catalogue/
                """
                nexusArtifactUploader(
                nexusVersion: 'nexus3',
                protocol: 'http',
                nexusUrl: "${nexusURL}",
                groupId: 'com.roboshop',
                version: "${packageVersion}",
                repository: "${repositoryName}",
                credentialsId: 'nexus-login-credentials',       //created credentials in manage jenkins in jenkins dashboard
                artifacts: [
                    [artifactId: "${repositoryName}",
                    classifier: '',
                    file: '92-roboshop-CI-Appln-Code/catalogue/catalogue' + '.zip',
                    type: 'zip']
                ]
                )
            }
        }
        //ROBOSHOP_INFRA_CD_DEPLOY/catalogue_deploy --> should be pipeline name in jenkins tool which needed to called 
        stage("Trigger CD pipeline For Deploy") {
            steps {
                script {
                    def buildParams = [
                        string(name:'Version', value: "${packageVersion}"),
                        string(name:'Environment', value: "dev")
                    ]
                    build job: "ROBOSHOP_INFRA_CD_DEPLOY/catalogue_deploy", 
                                wait: true, 
                                parameters: buildParams
                }
            }
        }
    }
    post {
        always {
            echo "CI process completed-Always"
            deleteDir()
        }
        success {
            echo "CI process completed Successfully"
        }
        failure {
            echo "CI process Failed"
        }
    }
}