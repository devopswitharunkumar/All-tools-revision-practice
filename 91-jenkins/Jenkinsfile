pipeline {
    agent {
        node {
            label 'Agent-1'
        }
    } 
    environment {
        Greeting = "DEVOPS"
    }
    options {
        timestamps()
        disableConcurrentBuilds()
        timeout(time: 30, unit: 'MINUTES')
        retry(2)
        quietPeriod(5)
    }
    parameters {
        string(name:'Version', defaultValue:'1.0', description: 'Stringexample')
        text(name:'normal_text', defaultValue:'example', description:'textexample')
        booleanParam(name:'Run_tests', defaultValue: true, description: 'Booleanexample')
        choice(name:'Environment', choices:['Dev','QA','prod'], description:'choices')
        password(name:'password', defaultValue:'SECRET', description:'Enter Password')
    }

    stages {
        stage("Building") {
            steps {
                echo "This is Building Stage"
            }
        }
        stage("Test") {
            steps {
                echo "This is test Stage"
            }
        }
        stage("Scan") {
            steps {
                echo "This is Scanning Stage"
            }
        }
        stage("Deploy") {
            steps {
                echo "This is Deploy Stage"
            }
        }
        stage("Greet") {
            steps {
                echo "Hi Im learning ${Greeting} and ${params.Version} and ${params.Environment}"
                sh """
                    echo "prints all the available environmant variables"
                    env
                """
            }
        }
        stage("Params") {
            steps {
                echo "Hi Im learning ${Greeting} and ${params.Version} and ${params.Run_tests} and ${params.normal_text}"
            }
        }
    }
    post {
        always {
            echo "ALWAYS - This action will execute always irrespective of pipeline build is failed or success or aborted"
            //we can give them like this inside condition block
                cleanWs()           //Cleans the entire Jenkins workspace
                deleteDir()         //Deletes the current working directory.
        }
        success {
            echo "SUCCESS - This action will execute only if pipeline or stage build is successful"
        }
        failure {
            echo "FAILURE - This action will execute only if pipeline or stage build is failed"
        }
        unsuccessful {
            echo "UNSUCCESSFUL - This action will execute if pipeline or stage build is other than success for all remaining issues"
        }
        aborted {
            echo "ABORTED - This action will execute only if the pipeline build is abort os stop manually"
        }

        unstable {
            echo "UNSTABLE - This action will execute only if the pipeline's current build is unstable"
        }
        fixed {
            echo "FIXED - This action will execute only if the pipeline's previous build is unstable or failed but current build is successful"
        }
        changed {
            echo "CHANGED - This action will execute only if the pipeline's current build is diff/changed compared to previous build"
        }
        regression {
            echo "REGRESSION - This action will execute only if the pipeline's previous build was successful or stable but the current build becomes unstable or fails."
        }
        cleanup {
            echo "CLEANUP - This action will execute only after all the conditions evaluated & regardless of the pipeline result "
        }   
    }
}