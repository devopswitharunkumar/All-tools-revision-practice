pipeline {
    agent {
        node {
            label 'Agent-1'
        }
    } 

    stages {
        stage("Building") {
            steps {
                echo "This is Building Stage"
            }
        }
        stage("Test") {
            steps {
                echo "This is test Stage"
            }
        }
        stage("Scan") {
            steps {
                echo "This is Scanning Stage"
            }
        }
        stage("Deploy") {
            steps {
                echo "This is Deploy Stage"
            }
        }
    }
    post {
        always {
            echo "ALWAYS - This action will execute always irrespective of pipeline build is failed or success or aborted"
        }
        success {
            echo "SUCCESS - This action will execute only if pipeline or stage build is successful"
        }
        failure {
            echo "FAILURE - This action will execute only if pipeline or stage build is failed"
        }
        unsuccessful {
            echo "UNSUCCESSFUL - This action will execute if pipeline or stage build is other than success for all remaining issues"
        }
        aborted {
            echo "ABORTED - This action will execute only if the pipeline build is abort os stop manually"
        }
    }
}