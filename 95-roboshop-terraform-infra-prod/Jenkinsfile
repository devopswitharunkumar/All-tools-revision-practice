pipeline {
    agent {
        node {
            label 'Agent-1'
        }
    }
    options {
        ansiColor('xterm')
        timeout(time:30, unit:'MINUTES')
        disableConcurrentBuilds()
    }
    stages {
        stage("VPC"){
            steps {
                sh """
                    cd 9-roboshop-terraform-infra-prod/01-vpc/
                    terraform init -reconfigure
                    terraform plan
                    terraform apply -auto-approve
                """
            }
            
        }
        stage("SG"){
            steps {
                sh """
                    cd 9-roboshop-terraform-infra-prod/02-sg/
                    terraform init -reconfigure
                    terraform plan
                    terraform apply -auto-approve
                """
            }
        }
        stage("VPN"){
            steps {
                sh """
                    cd 9-roboshop-terraform-infra-prod/03-vpn/
                    terraform init -reconfigure
                    terraform plan
                    terraform apply -auto-approve
                """
            }
        }
        stage('Databases_And_APP_ALB') {
            parallel {
                stage("DB"){
                    steps {
                        sh """
                            cd 9-roboshop-terraform-infra-prod/04-databases/
                            terraform init -reconfigure
                            terraform plan
                            terraform apply -auto-approve
                        """
                    }
                }
                stage("APP_ALB"){
                    steps {
                        sh """
                            cd 9-roboshop-terraform-infra-prod/05-app-alb/
                            terraform init -reconfigure
                            terraform plan
                            terraform apply -auto-approve
                        """
                    }
                }
            }
        }
    }
    post {
        always {
            echo "Terraform Pipeline Creation successful or failed or aborted always runs For PRODUCTION Environment"
        }
        success {
            echo "Terraform infra Creation for DEVELOPMENT Environment PRODUCTION Successfull"
        }
        failure {
            echo "Terraform infra Creation for DEVELOPMENT Environment PRODUCTION Failed"
        }
    }
}

