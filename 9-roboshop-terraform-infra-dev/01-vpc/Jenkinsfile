pipeline {
    agent {
        node {
            label 'Agent-1'
        }
    }
    options {
        timeout(time:30, unit:'MINUTES')
        disableConcurrentBuilds()
    }
    // parameters{
    //     choice(name:'command', choices['Apply', 'Destroy'])
    // }
    stages {
        stage("Init"){
            steps {
                sh """
                    cd 9-roboshop-terraform-infra-dev/01-vpc/
                    terraform init -reconfigure
                """
            }
            
        }
        stage("Plan"){
            steps {
                sh """
                    cd 9-roboshop-terraform-infra-dev/01-vpc/
                    terraform plan
                """
            }
        }
        stage("Approve"){
            input {
                message 'Do You want to Approve ?'
                ok 'Yes we shhould.'
            }
            steps {
                sh """
                    cd 9-roboshop-terraform-infra-dev/01-vpc/
                    terraform apply -auto-approve
                """
            }
        }
    }
    post {
        always {
            echo "Terraform VPC Pipeline successful or failed or aborted always runs"
        }
        success {
            echo "Terraform VPC Pipeline successful"
        }
        failure {
            echo "Terraform VPC Pipeline failed"
        }
    }
}