pipeline {
    agent {
        node {
            label 'Agent-1'
        }
    }
    options {
        ansiColor('xterm')
        timeout(time:30, unit:'MINUTES')
        disableConcurrentBuilds()
    }
    stages {
        stage("VPC"){
            steps {
                sh """
                    cd 9-roboshop-terraform-infra-dev/01-vpc/
                    terraform init -reconfigure
                    terraform plan
                    terraform apply -auto-approve
                """
            }
            
        }
        stage("SG"){
            steps {
                sh """
                    cd 9-roboshop-terraform-infra-dev/02-sg/
                    terraform init -reconfigure
                    terraform plan
                    terraform apply -auto-approve
                """
            }
        }
        stage("VPN"){
            steps {
                sh """
                    cd 9-roboshop-terraform-infra-dev/03-vpn/
                    terraform init -reconfigure
                    terraform plan
                    terraform apply -auto-approve
                """
            }
        }
        stage('Databases_And_APP_ALB') {
            parallel {
                stage("DB"){
                    steps {
                        sh """
                            cd 9-roboshop-terraform-infra-dev/04-databases/
                            terraform init -reconfigure
                            terraform plan
                            terraform apply -auto-approve
                        """
                    }
                }
                stage("APP_ALB"){
                    steps {
                        sh """
                            cd 9-roboshop-terraform-infra-dev/05-app-alb/
                            terraform init -reconfigure
                            terraform plan
                            terraform apply -auto-approve
                        """
                    }
                }
            }
        }
        stage('Catalogue-CI') {
            steps {
                build job: 'ROBOSHOP_APPLN_INFRA/catalogue-CI/feature-1',
                        wait: true,
                        propagate: true
            }
        }

        stage("ACM_CERTIFICATE"){
            steps {
                sh """
                    cd 9-roboshop-terraform-infra-dev/07-acm-certificate/
                    terraform init -reconfigure
                    terraform plan
                    terraform apply -auto-approve
                """
            }
        }
        stage("WEB_ALB"){
            steps {
                sh """
                    cd 9-roboshop-terraform-infra-dev/08-web-alb/
                    terraform init -reconfigure
                    terraform plan
                    terraform apply -auto-approve
                """
            }
        }
        stage('Web-CI') {
            steps {
                build job: 'ROBOSHOP_APPLN_INFRA/web-CI/feature-web-1',
                        wait: true,
                        propagate: true
            }
        }
        stage("CDN"){
            steps {
                sh """
                    cd 9-roboshop-terraform-infra-dev/10-cdn/
                    terraform init -reconfigure
                    terraform plan
                    terraform apply -auto-approve
                """
            }
        }    
        stage('User-CI') {
            steps {
                build job: 'ROBOSHOP_APPLN_INFRA/user-CI/feature-user-1',
                        wait: true,
                        propagate: true
            }
        }
        stage('Cart-CI') {
            steps {
                build job: 'ROBOSHOP_APPLN_INFRA/cart-CI/feature-user-1',
                        wait: true,
                        propagate: true
            }
        }
        stage('Shipping-CI') {
            steps {
                build job: 'ROBOSHOP_APPLN_INFRA/shipping-CI/feature-shipping-1',
                        wait: true,
                        propagate: true
            }
        }
        stage('Payment-CI') {
            steps {
                build job: 'ROBOSHOP_APPLN_INFRA/payment-CI/feature-payment-1',
                        wait: true,
                        propagate: true
            }
        }
    }
    post {
        always {
            echo "Terraform Pipeline Creation successful or failed or aborted always runs For DEVELOPMENT Environment"
        }
        success {
            echo "Terraform infra Creation for DEVELOPMENT Environment deployment Successfull"
        }
        failure {
            echo "Terraform infra Creation for DEVELOPMENT Environment deployment Failed"
        }
    }
}

