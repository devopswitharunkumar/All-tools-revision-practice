pipeline {
    agent {
        node {
            label 'Agent-1'
        }
    }
    options {
        ansiColor('xterm')
        timeout(time:30, unit:'MINUTES')
        disableConcurrentBuilds()
    }
    stages {
        stage('Databases_And_APP_ALB') {
            parallel {
                stage("APP_ALB"){
                    steps {
                        sh """
                            cd 9-roboshop-terraform-infra-dev/05-app-alb/
                            terraform init -reconfigure
                            terraform destroy -auto-approve
                        """
                    }
                }
                stage("DB"){
                    steps {
                        sh """
                            cd 9-roboshop-terraform-infra-dev/04-databases/
                            terraform init -reconfigure
                            terraform destroy -auto-approve
                        """
                    }
                }                
            }
        }
        stage("VPN"){
            steps {
                sh """
                    cd 9-roboshop-terraform-infra-dev/03-vpn/
                    terraform init -reconfigure        
                    terraform destroy -auto-approve
                """
            }
        }
        stage("SG"){
            steps {
                sh """
                    cd 9-roboshop-terraform-infra-dev/02-sg/
                    terraform init -reconfigure                    
                    terraform destroy -auto-approve
                """
            }
        }
        stage("VPC"){
            steps {
                sh """
                    cd 9-roboshop-terraform-infra-dev/01-vpc/
                    terraform init -reconfigure                    
                    terraform destroy -auto-approve
                """
            }
            
        }
        
        
        
    }
    post {
        always {
            echo "Terraform Pipeline Destrution successful or failed or aborted always runs For DEVELOPMENT Environment"
        }
        success {
            echo "Terraform infra Destrution for DEVELOPMENT Environment deployment Successfull"
        }
        failure {
            echo "Terraform infra Destrution for DEVELOPMENT Environment deployment Failed"
        }
    }
}

